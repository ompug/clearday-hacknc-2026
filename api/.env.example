# Copy to api/.env and fill in. api/.env is gitignored; never commit real values.
# Nessie (Capital One sandbox)
NESSIE_API_KEY=your-nessie-key
NESSIE_BASE_URL=https://prod-api.nessieisreal.com

# ElevenLabs
ELEVENLABS_API_KEY=sk_your-elevenlabs-key
ELEVENLABS_VOICE_ID=your-voice-id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Gemini
GEMINI_API_KEY=

# Which database to use: local (docker-compose TimescaleDB) or tiger (DATABASE_URL)
DB_TARGET=local
# Database: Tiger Cloud (primary)
DATABASE_URL=postgresql://tsdbadmin:password@host.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require
# Local Docker TimescaleDB backup
DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5432/clearday

# Session cookie signing secret
SESSION_SECRET=
