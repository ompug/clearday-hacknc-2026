# Clearday Home device config. Copy to device/.env (gitignored) on the board.
# Only the household device token belongs here: no Nessie, Gemini or ElevenLabs keys.
CLEARDAY_API_URL=http://192.168.1.10:8000
CLEARDAY_DEVICE_TOKEN=
# fake | wiz | kasa  (wiz and kasa are empty slots until a bulb is chosen)
CLEARDAY_BULB=fake
CLEARDAY_BULB_IP=
# bridge (on the UNO Q, via App Lab's arduino.app_utils) | log
CLEARDAY_MATRIX=log
CLEARDAY_AUDIO=1
# Optional: /dev/input/eventN; auto-detects a device named like a keypad otherwise
CLEARDAY_KEYPAD_DEVICE=
CLEARDAY_BRIEFING_KEY=KEY_KPENTER
CLEARDAY_LOG_DIR=logs
CLEARDAY_POLL_SECONDS=2
